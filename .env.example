# ==============================================================================
# 1. AI & PROCESSING CONFIGURATION
# ==============================================================================
# Your Google Gemini API Key
# https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_api_key_here

# The Gemini model to use for segmentation (Defaults to gemini-3.8-flash if left blank)
GEMINI_MODEL=gemini-3.8-flash

# (Optional) Absolute path to your FFmpeg binary. 
# Leave blank to automatically use the "ffmpeg" command in your system PATH,
# or specify path if needed (e.g., /opt/homebrew/bin/ffmpeg, ./bin/ffmpeg)
FFMPEG_PATH=

# ==============================================================================
# 2. LOCAL STORAGE PATHS (macOS / Google Drive)
# ==============================================================================
# Absolute path to the folder containing your unedited raw WAV files
# (If you use the Google Drive desktop app on macOS, it will look similar to this:)
# RAW_AUDIO_DIR=/Users/yourusername/Library/CloudStorage/GoogleDrive-user@example.com/My Drive/[Raw] Recordings
RAW_AUDIO_DIR=/Path/To/Your/Raw/Recordings

# Absolute path to the destination folder where sliced files and reports will be saved
# (If you use the Google Drive desktop app on macOS, it will look similar to this:)
# PROCESSED_AUDIO_DIR=/Users/yourusername/Library/CloudStorage/GoogleDrive-user@example.com/My Drive/[Processed] Recordings
PROCESSED_AUDIO_DIR=/Path/To/Your/Processed/Output

# Absolute path to the staging recordings folder where files wait for manual verification
STAGING_AUDIO_DIR=/Path/To/Your/Staging/Recordings

# Absolute path to the verified recordings folder
VERIFIED_AUDIO_DIR=/Path/To/Your/Verified/Recordings

# Absolute path to the destination folder for generated videos
VIDEOS_DIR=/Path/To/Your/Verified/Recordings/Videos

# (Optional) Absolute path to the destination folder for generated MP3 audio files.
# Defaults to $VERIFIED_AUDIO_DIR/MP3 if left undefined.
# MP3_DIR=/Path/To/Your/Verified/Recordings/MP3

# ==============================================================================
# 3. PLANNING CENTER API CONFIGURATION (DATA SOURCE)
# https://api.planningcenteronline.com/personal_access_tokens
# ==============================================================================
PCO_APP_ID=your_planning_center_application_id_here
PCO_SECRET=your_planning_center_secret_here

# (Optional) The specific PCO Service Type ID (e.g., your main Weekend Service).
# Flexible Configuration:
# - If defined here, the orchestrator will bypass the Service Type menu and load instantly.
# - If left blank, the orchestrator will fetch your service types dynamically 
#   and provide an interactive CLI menu for you to choose from at runtime.
# PCO_SERVICE_TYPE_ID=your_service_type_id_number_here

# ==============================================================================
# 4. GITHUB API CONFIGURATION (FOR DIFF VIEWER)
# https://github.com/settings/tokens
# ==============================================================================
# A GitHub Personal Access Token (classic) with `repo` scope to read private files.
GITHUB_PAT=your_github_personal_access_token_here
